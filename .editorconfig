root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# rustfmt and PEP 8 indent by four, and the files already do.
[*.{rs,py}]
indent_size = 4

# Two trailing spaces are a line break in Markdown.
[*.md]
trim_trailing_whitespace = false

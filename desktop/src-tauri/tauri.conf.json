{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Braid",
  "version": "0.1.0",
  "identifier": "dev.braid.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "braid",
        "width": 1240,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "url": "index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Multi-agent coding harness",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/braid"
    ]
  }
}
